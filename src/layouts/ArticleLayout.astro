---
import BaseLayout from './BaseLayout.astro';
import 'katex/dist/katex.min.css';
const { entry, headings } = Astro.props;
const sections = headings.filter((h:any) => h.depth === 2);
---
<BaseLayout title={`${entry.data.title} | ARTPHASE`} description={entry.data.description}>
  <header class="article-header shell">
    <a class="back-link" href="/engineering-notes">← Engineering Notes</a><p class="eyebrow">{entry.data.category}</p>
    <h1>{entry.data.title}</h1><p class="article-subtitle">{entry.data.subtitle}</p>
    <div class="article-meta"><span>Published {entry.data.publicationDate.toLocaleDateString('en-CA',{year:'numeric',month:'long',day:'numeric'})}</span>{entry.data.updatedDate && <span>Updated {entry.data.updatedDate.toLocaleDateString('en-CA',{year:'numeric',month:'long',day:'numeric'})}</span>}<span>{entry.data.readingTime}</span></div>
  </header>
  <div class="article-grid shell">
    <article class="prose"><slot /></article>
    <aside class="toc"><strong>On this page</strong><ol>{sections.map((h:any)=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></aside>
  </div>
  <nav class="article-nav shell"><a href="/engineering-notes">← All engineering notes</a><span>Next note will appear here</span></nav>
</BaseLayout>
