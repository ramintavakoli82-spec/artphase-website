---
import BaseLayout from './BaseLayout.astro';
import 'katex/dist/katex.min.css';
const { entry, headings, previousNote, nextNote } = Astro.props;
const sections = headings.filter((h:any) => h.depth === 2);
const compactMobileTitle = [
  'how-active-harmonic-filter-cancels-vfd-harmonics',
  'how-power-factor-correction-reduces-current',
  'passive-harmonic-filter-without-shunt-contactor',
  'available-fault-current-vs-sccr',
].includes(entry.id);
const articleUrl = new URL(Astro.url.pathname, 'https://artphase.ca');
const socialImage = entry.data.socialImage ?? entry.data.coverImage;
const articleImage = entry.data.video ? socialImage : entry.data.coverImage;
const articleStructuredData = {
  '@type': 'TechArticle',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publicationDate.toISOString(),
  dateModified: (entry.data.updatedDate ?? entry.data.publicationDate).toISOString(),
  mainEntityOfPage: articleUrl.href,
  author: { '@type': 'Person', name: 'Ramin Tavakoli' },
  publisher: { '@type': 'Organization', name: 'ARTPHASE', url: 'https://artphase.ca' },
  image: articleImage ? new URL(articleImage, 'https://artphase.ca').href : undefined,
  keywords: entry.data.tags.join(', ')
};
const videoStructuredData = entry.data.video ? {
  '@type': 'VideoObject',
  name: entry.data.video.name,
  description: entry.data.video.description,
  thumbnailUrl: new URL(entry.data.video.thumbnailUrl, 'https://artphase.ca').href,
  uploadDate: entry.data.publicationDate.toISOString(),
  duration: entry.data.video.duration,
  contentUrl: new URL(entry.data.video.contentUrl, 'https://artphase.ca').href,
} : undefined;
const structuredData = videoStructuredData
  ? { '@context': 'https://schema.org', '@graph': [articleStructuredData, videoStructuredData] }
  : { '@context': 'https://schema.org', ...articleStructuredData };
---
<BaseLayout title={entry.data.title} fullTitle={entry.data.seoTitle} description={entry.data.description} socialTitle={entry.data.socialTitle} socialDescription={entry.data.socialDescription} image={socialImage} imageAlt={entry.data.coverAlt} type="article" structuredData={structuredData}>
  <header class:list={['article-header', 'shell', compactMobileTitle && 'article-header--compact-mobile-title']}>
    <a class="back-link" href="/engineering-notes">← Engineering Notes</a><p class="eyebrow">{entry.data.noteNumber ? `Engineering Note #${entry.data.noteNumber}` : entry.data.category}</p>
    {entry.data.noteNumber && <p class="article-category">{entry.data.category}</p>}
    <h1>{entry.data.title}</h1><p class="article-subtitle">{entry.data.subtitle}</p>
    <div class="article-meta"><span>Published {entry.data.publicationDate.toLocaleDateString('en-CA',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</span>{entry.data.updatedDate && <span>Updated {entry.data.updatedDate.toLocaleDateString('en-CA',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</span>}<span>{entry.data.readingTime}</span></div>
  </header>
  {entry.data.coverImage && entry.data.coverDisplay && <figure class="article-cover shell"><img src={entry.data.coverImage} alt={entry.data.coverAlt} width="1024" height="1536" decoding="async" fetchpriority="high" /><figcaption>{entry.data.coverCaption}</figcaption></figure>}
  <div class="article-grid shell">
    <article class="prose"><slot /></article>
    <aside class="toc"><strong>On this page</strong><ol>{sections.map((h:any)=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></aside>
  </div>
  <nav class="article-nav shell" aria-label="Adjacent engineering notes">
    {previousNote ? <a rel="prev" href={`/engineering-notes/${previousNote.id}`}>← {previousNote.data.title}</a> : <a href="/engineering-notes">← All engineering notes</a>}
    {nextNote ? <a rel="next" href={`/engineering-notes/${nextNote.id}`}>{nextNote.data.title} →</a> : <a href="/engineering-notes">All engineering notes →</a>}
  </nav>
</BaseLayout>
