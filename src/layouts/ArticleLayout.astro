---
import BaseLayout from './BaseLayout.astro';
import 'katex/dist/katex.min.css';
const { entry, headings } = Astro.props;
const sections = headings.filter((h:any) => h.depth === 2);
const articleUrl = new URL(Astro.url.pathname, 'https://artphase.ca');
const structuredData = {
  '@context': 'https://schema.org', '@type': 'TechArticle',
  headline: entry.data.title, description: entry.data.description,
  datePublished: entry.data.publicationDate.toISOString(),
  dateModified: (entry.data.updatedDate ?? entry.data.publicationDate).toISOString(),
  mainEntityOfPage: articleUrl.href,
  author: { '@type': 'Person', name: 'Ramin Tavakoli' },
  publisher: { '@type': 'Organization', name: 'ARTPHASE', url: 'https://artphase.ca' },
  image: entry.data.coverImage ? new URL(entry.data.coverImage, 'https://artphase.ca').href : undefined,
  keywords: entry.data.tags.join(', ')
};
---
<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.coverImage} type="article" structuredData={structuredData}>
  <header class="article-header shell">
    <a class="back-link" href="/engineering-notes">← Engineering Notes</a><p class="eyebrow">{entry.data.category}</p>
    <h1>{entry.data.title}</h1><p class="article-subtitle">{entry.data.subtitle}</p>
    <div class="article-meta"><span>Published {entry.data.publicationDate.toLocaleDateString('en-CA',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</span>{entry.data.updatedDate && <span>Updated {entry.data.updatedDate.toLocaleDateString('en-CA',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</span>}<span>{entry.data.readingTime}</span></div>
  </header>
  {entry.data.coverImage && <figure class="article-cover shell"><img src={entry.data.coverImage} alt={entry.data.coverAlt} width="1024" height="1536" decoding="async" fetchpriority="high" /><figcaption>{entry.data.coverCaption}</figcaption></figure>}
  <div class="article-grid shell">
    <article class="prose"><slot /></article>
    <aside class="toc"><strong>On this page</strong><ol>{sections.map((h:any)=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></aside>
  </div>
  <nav class="article-nav shell"><a href="/engineering-notes">← All engineering notes</a><span>Next note will appear here</span></nav>
</BaseLayout>
