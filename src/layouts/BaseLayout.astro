---
import '../styles/global.css';
import '../styles/extended.css';
import { siteConfig } from '../config/site';

const {
  title = siteConfig.title,
  description = siteConfig.description,
  robots = 'index, follow',
  analytics = true,
  image,
  type = 'website',
  structuredData
} = Astro.props;

const canonical = siteConfig.domain
  ? new URL(Astro.url.pathname, siteConfig.domain)
  : undefined;

const pageTitle =
  title === siteConfig.title
    ? siteConfig.title
    : `${title} | ARTPHASE`;

const socialImage = image && siteConfig.domain ? new URL(image, siteConfig.domain) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />

    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={description} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <meta name="author" content="Ramin Tavakoli" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#17222d" />
    <meta name="application-name" content="ARTPHASE" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ARTPHASE" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    {analytics && (
      <script
        is:inline
        defer
        src={siteConfig.analytics.scriptUrl}
        data-website-id={siteConfig.analytics.websiteId}
        data-domains={siteConfig.analytics.domains.join(',')}
        data-do-not-track="true"
      ></script>
    )}

    <script is:inline>
      if ('serviceWorker' in navigator &&
          (location.protocol === 'https:' || location.hostname === 'localhost')) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', {
            scope: '/',
            updateViaCache: 'none'
          }).catch(() => {});
        });
      }
    </script>
  </head>

  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">
          <strong>ARTPHASE</strong>
          <span>ENGINEERING NOTES</span>
        </a>

        <nav aria-label="Main navigation">
          {siteConfig.navigation.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="shell">
        <strong>ARTPHASE</strong>

        <span>
          Practical engineering notes, investigations and design observations.
        </span>

        <span class="footer-links">
          <a href="/privacy">Privacy</a>
          <span aria-hidden="true">·</span>
          <span>© {new Date().getFullYear()} Ramin Tavakoli</span>
        </span>
      </div>
    </footer>
  </body>
</html>
