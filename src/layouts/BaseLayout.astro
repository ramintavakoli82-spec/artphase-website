---
import '../styles/global.css';
import '../styles/extended.css';
import { siteConfig } from '../config/site';

const {
  title = siteConfig.title,
  description = siteConfig.description,
  robots = 'index, follow',
  analytics = true
} = Astro.props;

const canonical = siteConfig.domain
  ? new URL(Astro.url.pathname, siteConfig.domain)
  : undefined;

const pageTitle =
  title === siteConfig.title
    ? siteConfig.title
    : `${title} | ARTPHASE`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />

    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <meta name="author" content="Ramin Tavakoli" />
    <meta name="robots" content={robots} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {analytics && (
      <script
        is:inline
        defer
        src={siteConfig.analytics.scriptUrl}
        data-website-id={siteConfig.analytics.websiteId}
        data-domains={siteConfig.analytics.domains.join(',')}
        data-do-not-track="true"
      ></script>
    )}
  </head>

  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">
          <strong>ARTPHASE</strong>
          <span>ENGINEERING NOTES</span>
        </a>

        <nav aria-label="Main navigation">
          {siteConfig.navigation.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="shell">
        <strong>ARTPHASE</strong>

        <span>
          Practical engineering notes, investigations and design observations.
        </span>

        <span class="footer-links">
          <a href="/privacy">Privacy</a>
          <span aria-hidden="true">·</span>
          <span>© {new Date().getFullYear()} Ramin Tavakoli</span>
        </span>
      </div>
    </footer>
  </body>
</html>
