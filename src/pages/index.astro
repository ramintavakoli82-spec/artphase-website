---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="portal-home shell">
    <section class="home-hero">
      <div class="hero-content">
        <p class="eyebrow">KNOWLEDGE · TOOLS · REAL-WORLD ENGINEERING</p>

        <h1>Practical industrial electrical engineering notes and tools</h1>

        <p class="home-hero-intro">
          A collection of real-world investigations, calculations and design
          observations developed from practical experience in industrial
          electrical engineering.
        </p>

        <a class="hero-button" href="/engineering-notes">
          Explore Engineering Notes <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="hero-values" aria-label="ARTPHASE values">
        <span><b aria-hidden="true">✓</b> Practical &amp; applied</span>
        <span><b aria-hidden="true">✓</b> Independent &amp; technical</span>
        <span><b aria-hidden="true">✓</b> Built for industry</span>
      </div>
    </section>
  </div>
</BaseLayout>
