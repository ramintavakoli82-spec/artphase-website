---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { engineeringNoteCategories } from '../../config/site';
const notes = (await getCollection('notes', ({data})=>!data.draft)).sort((a,b)=>b.data.publicationDate.valueOf()-a.data.publicationDate.valueOf());
---
<BaseLayout title="Engineering Notes | ARTPHASE" description="Technical notes on motor control, VFDs, power quality and industrial electrical design.">
  <header class="page-header shell"><p class="eyebrow">Technical library</p><h1>Engineering Notes</h1><p>Practical investigations, calculations and design observations organized for reference.</p></header>
  <section class="library shell">
    <div class="filters"><label>Search notes<input id="note-search" type="search" placeholder="Search title, topic or tag…" /></label><div class="filter-buttons"><button class="active" data-filter="all">All</button>{engineeringNoteCategories.map(category=><button data-filter={category.slug} data-content-categories={JSON.stringify(category.contentCategories.map(value=>value.toLowerCase()))}>{category.label}</button>)}</div></div>
    <p id="empty-state" hidden></p><div class="notes-grid">{notes.map(note=><NoteCard note={note} />)}</div>
  </section>
  <script>
    const input=document.querySelector<HTMLInputElement>('#note-search'); const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')]; const cards=[...document.querySelectorAll<HTMLElement>('.note-card')]; const supportedCategories=new Set(buttons.map(button=>button.dataset.filter)); const requestedCategory=new URLSearchParams(window.location.search).get('category'); let category=requestedCategory&&supportedCategories.has(requestedCategory)?requestedCategory:'all';
    const getContentCategories=()=>{const button=buttons.find(item=>item.dataset.filter===category);if(!button?.dataset.contentCategories)return null;return new Set(JSON.parse(button.dataset.contentCategories) as string[])};
    const update=()=>{const q=input?.value.toLowerCase().trim()??'';const contentCategories=getContentCategories();let shown=0;cards.forEach(c=>{const categoryMatches=category==='all'||contentCategories?.has(c.dataset.category??'');const ok=categoryMatches&&(!q||c.dataset.search?.includes(q));c.hidden=!ok;if(ok)shown++});buttons.forEach(button=>button.classList.toggle('active',button.dataset.filter===category));const empty=document.querySelector<HTMLElement>('#empty-state');if(empty){empty.textContent=q?'No notes match this search.':'No published notes in this category yet.';empty.hidden=shown!==0}};
    input?.addEventListener('input',update);buttons.forEach(button=>button.addEventListener('click',()=>{category=button.dataset.filter??'all';const url=new URL(window.location.href);if(category==='all')url.searchParams.delete('category');else url.searchParams.set('category',category);window.history.pushState({},'',url);window.dispatchEvent(new PopStateEvent('popstate'))}));window.addEventListener('popstate',()=>{const nextCategory=new URLSearchParams(window.location.search).get('category');category=nextCategory&&supportedCategories.has(nextCategory)?nextCategory:'all';update()});update();
  </script>
</BaseLayout>
