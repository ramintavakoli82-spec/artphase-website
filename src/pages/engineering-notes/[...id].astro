---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
export async function getStaticPaths(){
  const notes=(await getCollection('notes',({data})=>!data.draft)).sort((a,b)=>a.data.publicationDate.valueOf()-b.data.publicationDate.valueOf());
  return notes.map((entry,index)=>({params:{id:entry.id},props:{entry,previousNote:notes[index-1],nextNote:notes[index+1]}}));
}
const { entry, previousNote, nextNote }=Astro.props; const { Content, headings }=await render(entry);
---
<ArticleLayout entry={entry} headings={headings} previousNote={previousNote} nextNote={nextNote}><Content /></ArticleLayout>
